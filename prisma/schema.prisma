generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                String     @id @default(cuid())
  name              String
  code              String     @unique
  description       String
  acceptanceVersion String
  owner             String?
  stage             String     @default("方案设计与概念验证")
  isDemo            Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  materials         Material[]
  clauses           Clause[]
  evidences         Evidence[]
  risks             Risk[]
  analysisRuns      AnalysisRun[]
  reviewEvents      ReviewEvent[]
}

model AnalysisRun {
  id          String    @id @default(cuid())
  projectId   String
  kind        String
  status      String    @default("running")
  model       String
  inputDigest String
  completed   Int       @default(0)
  total       Int       @default(0)
  summary     String    @default("")
  details     String    @default("[]")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
}

model ReviewEvent {
  id        String   @id @default(cuid())
  projectId String
  action    String
  target    String
  detail    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Material {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  category       String
  mimeType       String
  size           Int
  storagePath    String
  parseStatus    String   @default("pending")
  parsedContent  String?
  sourceLocation String?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Clause {
  id                 String          @id @default(cuid())
  projectId          String
  clauseId           String
  originalText       String
  object             String
  metric             String
  condition          String
  method             String
  requiredEvidence   String
  sourceFile         String
  sourceLocation     String
  confidence         Float
  confirmationStatus String          @default("pending")
  createdAt          DateTime        @default(now())
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceMatches    EvidenceMatch[]
  risks              Risk[]

  @@unique([projectId, clauseId])
  @@index([projectId])
}

model Evidence {
  id             String          @id @default(cuid())
  projectId      String
  evidenceId     String
  title          String
  fileName       String
  sourceLocation String
  excerpt        String
  isDemo         Boolean         @default(false)
  createdAt      DateTime        @default(now())
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  matches        EvidenceMatch[]
  risks          Risk[]

  @@unique([projectId, evidenceId])
  @@index([projectId])
}

model EvidenceMatch {
  id                  String   @id @default(cuid())
  clauseId            String
  evidenceId          String
  status              String
  reason              String
  confidence          Float
  requiresHumanReview Boolean  @default(true)
  createdAt           DateTime @default(now())
  clause              Clause   @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  evidence            Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([clauseId, evidenceId])
}

model Risk {
  id          String    @id @default(cuid())
  projectId   String
  clauseId    String?
  evidenceId  String?
  level       String
  type        String
  description String
  suggestion  String
  status      String    @default("open")
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clause      Clause?   @relation(fields: [clauseId], references: [id], onDelete: SetNull)
  evidence    Evidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([projectId])
}
